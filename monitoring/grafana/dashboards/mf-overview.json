  {
   "id": 5,
   "type": "bargauge",
   "title": "Zone별 평균 건강도",
   "datasource": {
    "type": "influxdb",
    "uid": "mf-influx"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "influxdb",
      "uid": "mf-influx"
     },
     "refId": "A",
     "query": "from(bucket: \"raw\") |> range(start: -2m) |> filter(fn: (r) => r._measurement == \"equipment\" and r._field == \"health\") |> last() |> group(columns: [\"zone\"]) |> mean() |> map(fn: (r) => ({ _value: r._value, zone: if r.zone == \"main\" then \"정밀조립\" else if r.zone == \"flex\" then \"유연생산\" else if r.zone == \"adapt\" then \"적응가공\" else \"정밀검사\" })) |> group()"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 40
       },
       {
        "color": "yellow",
        "value": 55
       },
       {
        "color": "green",
        "value": 70
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "displayName": "${__field.labels.zone}"
    },
    "overrides": []
   },
