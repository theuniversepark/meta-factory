     },
     "refId": "A",
     "query": "from(bucket: \"raw\") |> range(start: -2m) |> filter(fn: (r) => r._measurement == \"equipment\" and r._field == \"busy\" and (r.zone == \"${zone}\" or \"${zone}\" == \"all\")) |> last() |> group() |> sum() |> map(fn: (r) => ({ r with _field: \"가동 중\" }))"
    }
