    "orientation": "horizontal",
    "displayMode": "gradient",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": true
    },
    "showUnfilled": true
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "고장·정비 중 셀 수 (Zone별)",
   "datasource": {
    "type": "influxdb",
    "uid": "mf-influx"
   },
   "gridPos": {
    "x": 8,
    "y": 5,
    "w": 16,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "influxdb",
      "uid": "mf-influx"
     },
     "refId": "A",
     "query": "from(bucket: \"raw\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"equipment\" and r._field == \"down\") |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false) |> group(columns: [\"_time\", \"zone\"]) |> sum() |> group(columns: [\"zone\"])"
    }
   ],
   "description": "고장(DOWN) 또는 정비 중(MAINT)인 셀 수",
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 6,
      "showPoints": "never",
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "min",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
