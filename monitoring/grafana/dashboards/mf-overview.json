    "iconColor": "red",
    "name": "운영 이벤트 — 경보",
    "target": {
     "refId": "Anno",
     "query": "from(bucket: \"raw\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"event\" and r.level == \"alert\" and (r.zone == \"${zone}\" or \"${zone}\" == \"all\")) |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\") |> map(fn: (r) => ({ _time: r._time, text: r.title + (if exists r.text then \" — \" + r.text else \"\"), tags: r.zone }))"
    }
   },
   {
    "datasource": {
     "type": "influxdb",
     "uid": "mf-influx"
    },
    "enable": true,
    "iconColor": "orange",
    "name": "운영 이벤트 — 주의",
    "target": {
     "refId": "Anno",
     "query": "from(bucket: \"raw\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"event\" and r.level == \"warn\" and (r.zone == \"${zone}\" or \"${zone}\" == \"all\")) |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\") |> map(fn: (r) => ({ _time: r._time, text: r.title + (if exists r.text then \" — \" + r.text else \"\"), tags: r.zone }))"
    }
   },
   {
    "datasource": {
     "type": "influxdb",
